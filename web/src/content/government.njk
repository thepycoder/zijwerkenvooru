---
layout: layouts/page
permalink: "/government/"
title: "De Belgische Federale Regering"
description: "Ontdek de samenstelling van de Federale Regering van België"
---

<h1 class="capitalize">De Federale Regering</h1>
<p>Bekijk alle ministers in de federale regering.</p>

<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));  gap: 0.4rem;">
    {% for name, mandates in functions %}
    {% set active = mandates | getActive(page.date) %}
    {% if active %}
        <div class="card padding flex column gap">
            {% set primaryColor = partyColors[active.party | lower].primary or '#95a5a6' %}
            {% set secondaryColor = partyColors[active.party | lower].secondary or '#95a5a6' %}
            {% set imgSrc = "../content/members/img/"
              + (name | slugify)
              + ".jpg"
            %}
            {% set has_image = imgSrc | imageExists %}
            <div class="flex row gap">
                <img src="{{ imgSrc if has_image else 'https://placehold.co/100?text=%E2%9D%93' }}" alt="A picture of {{ first_name }} {{ last_name }}" style="width: 4rem; height: 4rem; object-fit: cover;">
                <div class="flex column gap">
                    <h3 style="margin: 0;">{{ name }}</h3>
                    <a href="/parties/{{ active.party | slugify }}/" class="badge-link"><span class="party small" style="font-weight: bold; color: {{ primaryColor }}; background-color: {{ secondaryColor }};">{{ active.party }}</span></a>
                </div>
            </div>
            <p>{{ active.function }}</p>
        </div>
    {% endif %}
    {% endfor %}
</div>

<style>
.government-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.5rem;
}

.minister-card {
  border: 1px solid #ddd;
  padding: 1rem;
  text-align: center;
}

.minister-card img {
  width: 100%;
  height: auto;
  object-fit: cover;
}

.minister-card h3 {
  margin: 0.75rem 0 0.25rem;
}

.minister-card .function {
  font-size: 0.9rem;
}

.minister-card .start-date {
  font-size: 0.8rem;
  color: #555;
}
</style>
