---
layout: layouts/page
pagination:
    data: collections.localizedDossiers
    size: 1
    alias: dossier
    addAllPagesToCollections: true
permalink: "sessions/{{ dossier.session_id }}/dossiers/{{ dossier.dossier_id }}/"
eleventyComputed:
    title: "zwvu | {{ dossier.title }}"
    description: "Over het dossier: {{ dossier.title }} (dossier {{ dossier.dossier_id }})"
---

<!-- PAGEFIND EXCERPT -->
<span style="display: none" data-pagefind-meta="title">{{ languages['nl'][dossier.document_type] }}</span>
<span style="display: none" data-pagefind-body>{{ languages['nl'][dossier.document_type] }} over {{ dossier.title }}</span>

<!-- COMPONENTS -->
{%- from "components/vote-card.njk" import voteCard -%}

{# <p><a href="javascript:history.back()"><- TERUG</a></p> #}

<h1>Dossier {{ dossier.dossier_id }}</h1>

{% if dossier.summary %}
<h3 class="ai-hide-when-summary" style="font-weight: normal; margin-top: 0;">{{ dossier.title }}</h3>
<h3 class="ai-show-when-summary" style="font-weight: normal; margin-top: 0;">{{ dossier.summary.generated_title }}</h3>
{% else %}
<h3 style="font-weight: normal; margin-top: 0;">{{ dossier.title }}</h3>
{% endif %}


<!-- DOSSIER OVERVIEW -->
<div class="card padding info-list">
    <div class="info-item">
        <span class="icon-padded">{% icon "lucide:user" %}</span>
        <div>
            <p><span>Ingediend door</span></p>
            <p>
                {% for author in dossier.authors %}
                    {% if author.name == "Gouvernement/Regering (AUTEUR)" %}
                            <span>Regering</span><br>
                             {% elseif author.name == "Commission/Commissie (AUTEUR)" %}
                            <span>Commissie</span><br>
                            {% elseif author.name == "Sénat/Senaat (AUTEUR)" %}
                <span>Senaat</span><br>
                    {% else %}
                        {% set party = author.party | lower %}
                        {% set primaryColor = partyColors[party].primary or '#95a5a6' %}
                        {% set secondaryColor = partyColors[party].secondary or '#95a5a6' %}
                        <span>
                            <a href="/parties/{{ author.party | slugify }}/" class="badge-link"><span class="party small" style="font-weight: bold; color: {{ primaryColor }}; background-color: {{ secondaryColor }};">{{ author.party }}</span></a>
                            <a class="questioner" href="/members/{{ author.name | slugify }}/" class="respondent">{{ author.name }}</a>
                        </span><br>
                    {% endif %}
                {% endfor %}
            </p>
        </div>
    </div>
    <div class="info-item">
        <span class="icon-padded">{% icon "lucide:inbox" %}</span>
        <p>Ingediend op {{ dossier.submission_date | date }}</p>
    </div>
    <div class="info-item">
        <span class="icon-padded">{% icon "lucide:vote" %}</span>
        {% if dossier.status == "Aangenomen" %}
        <span class="topic" style="background-color: #28a745; color: white; margin-right: 0.4rem;">
        {{ languages['nl'].passed }}
        </span>
        {% elseif dossier.status == "Verworpen" %}
        <span class="topic" style="background-color: #dc3545; color: white; margin-right: 0.4rem;">
        {{ languages['nl'].failed }}
        </span>
        {% endif%}
        op {{ dossier.vote_date | date }}
    </div>
    <div class="info-item">
        <span class="icon-padded">{% icon "lucide:file-digit" %}</span>
        <p>Document <a href="https://www.dekamer.be/kvvcr/showpage.cfm?section=/flwb&language=nl&cfm=/site/wwwcfm/flwb/flwbn.cfm?lang=N&legislat={{ dossier.session_id }}&dossierID={{ dossier.dossier_id }}" target="_blank">{{ dossier.session_id }}K{{ dossier.dossier_id | padLeft(4, '0') }}</a></p>
    </div>
</div>

<!-- SHARE BUTTON -->
<button id="share-button">{{ languages['nl'].shareDossier }}</button>

<!-- VOTE CONTENTS -->
<h2>Waarover gaat dit</h2>
{% if dossier.summary %}
<div class="ai-show-when-summary">
    {% set summaryParts = dossier.summary.fact_summary.summary | splitSummary %}
    <div class="summary-fact-grid">
        <div class="summary-card summary-fact-problem">
            <span class="summary-ai-badge">AI</span>
            <h3>Welk probleem lost dit op of wat is het doel?</h3>
            <div class="summary-content">{{ summaryParts.problem | markdown | safe }}</div>
        </div>
        <div class="summary-card summary-fact-changes">
            <span class="summary-ai-badge">AI</span>
            <h3>Wat verandert er concreet in de praktijk?</h3>
            <div class="summary-content">{{ summaryParts.changes | markdown | safe }}</div>
        </div>
    </div>
</div>
<div class="ai-hide-when-summary">
    <p>Dit dossier gaat over "{{ dossier.title }}"</p>
</div>
{% else %}
<p>Dit dossier gaat over "{{ dossier.title }}"</p>
{% endif %}


<!-- TIMELINE OF DOSSIER -->
{% if dossier.subdocuments.length %}
<h2>Overzicht</h2>
<div class="timeline">
    <ul class="timeline-list">
        <!-- Vote Event if vote_date exists -->
        {% if dossier.vote_date %}
        <li class="dossier-event is-done">
            <span class="dot-icon">{% icon "lucide:vote" %}</span>
            <div class="info">
                <p><span class="bold">Stemming in de kamer</span></p>
                <p style="font-size: small;">{{ dossier.vote_date | date }}</p>
                {% if dossier.status == "Aangenomen" %}
                <span class="topic" style="background-color: #28a745; color: white;">
                {{ languages['nl'].passed }}
                </span>
                {% elseif dossier.status == "Verworpen" %}
                <span class="topic" style="background-color: #dc3545; color: white;">
                {{ languages['nl'].failed }}
                </span>
                {% endif%}
            </div>
        </li>
        {% endif %}

        {% for doc in dossier.subdocuments | reverse(true) %}
        {% if doc.id != 1 %}
        <li class="dossier-event is-done">
            {% if doc.type == "Amendement" %}
            <span class="dot-icon">{% icon "lucide:git-pull-request-arrow" %}</span>
            {% else %}
            <span class="dot-icon">{% icon "lucide:paperclip" %}</span>
            {% endif%}

            <div class="info">
                <p><span class="bold">{{ doc.id | padLeft(3, '0') }}. {{ languages['nl'][doc.type] }}</span> (<a href="https://www.dekamer.be/FLWB/PDF/{{ dossier.session_id }}/{{ dossier.dossier_id | padLeft(4, '0') }}/{{ dossier.session_id }}K{{ dossier.dossier_id | padLeft(4, '0') }}{{ doc.id }}.pdf" target="_blank">{{ dossier.session_id }}K{{ dossier.dossier_id | padLeft(4, '0') }}{{ doc.id }}</a>)</p>
                <p style="font-size: small;">{{ doc.date | date }}</p>
                <p style="font-size: small;"></p>
                <ul style="display: flex; flex-direction: column; gap: 0.2rem;" class="links">
                    {% for author in doc.authors %}
                    {% set party = author.party | lower %}
                    {% set primaryColor = partyColors[party].primary or '#95a5a6' %}
                    {% set secondaryColor = partyColors[party].secondary or '#95a5a6' %}
                    <li style="display: flex; margin-left: 0; justify-content: space-between; width: 100%; gap: 1rem;"><a href="/parties/{{ author.party | slugify }}/" class="badge-link"><span class="party small" style="color: {{ primaryColor }}; background-color: {{ secondaryColor }};">{{ author.party }}</span></a><a href="/members/{{ author.name | slugify }}/">{{ author.name }}</a></li>
                    {% endfor %}
                </ul>

                <!-- VOTE -->
                {% if doc.votes[0] %}
                <a class="flex space-between align-center" style="width: 100%;" href="/sessions/{{ doc.votes[0].session_id }}/meetings/plenary/{{ doc.votes[0].meeting_id }}/votes/{{doc.votes[0].vote_id}}/">
                <div class="vote-bar" style="width: 90%;">
                    <div class="bar-segment yes"
                         style="width: {{ (doc.votes[0].yes_count / ((doc.votes[0].yes_count | int) + (doc.votes[0].no_count | int) + (doc.votes[0].abstain_count | int)) * 100).toFixed(1) }}%">
                        {% if doc.votes[0].yes_count > 0 %}
                        <span class="bar-label">{{ (doc.votes[0].yes_count / ((doc.votes[0].yes_count | int) + (doc.votes[0].no_count | int) + (doc.votes[0].abstain_count | int)) * 100).toFixed(1) }}%</span>
                        {% endif %}
                    </div>
                    <div class="bar-segment no"
                         style="width: {{ (doc.votes[0].no_count / ((doc.votes[0].yes_count | int) + (doc.votes[0].no_count | int) + (doc.votes[0].abstain_count | int)) * 100).toFixed(1) }}%">
                        {% if doc.votes[0].no_count > 0 %}
                        <span class="bar-label">{{ (doc.votes[0].no_count / ((doc.votes[0].yes_count | int) + (doc.votes[0].no_count | int) + (doc.votes[0].abstain_count | int)) * 100).toFixed(1) }}%</span>
                        {% endif %}
                    </div>
                    <div class="bar-segment abstain"
                         style="width: {{ (doc.votes[0].abstain_count / ((doc.votes[0].yes_count | int) + (doc.votes[0].no_count | int) + (doc.votes[0].abstain_count | int)) * 100).toFixed(1) }}%">
                        {% if doc.votes[0].abstain_count > 0 %}
                        <span class="bar-label">{{ (doc.votes[0].abstain_count / ((doc.votes[0].yes_count | int) + (doc.votes[0].no_count | int) + (doc.votes[0].abstain_count | int)) * 100).toFixed(1) }}%</span>
                        {% endif %}
                    </div>
                </div>
                {% icon "lucide:chevron-right" %}
                </a>

                <p class="vote-numbers">
                    <span class="vote-dot yes"></span><span>{{ languages['nl'].yes }} ({{ doc.votes[0].yes_count }})</span>
                    <span class="vote-dot no"></span><span>{{ languages['nl'].no }} ({{ doc.votes[0].no_count }})</span>
                    <span class="vote-dot abstain"></span><span>{{ languages['nl'].abstain }} ({{ doc.votes[0].abstain_count }})</span>
                </p>
                {% endif %}

            </div>
        </li>
        {% endif %}
        {% endfor %}

        <!-- Initial Submission -->
        <li class="dossier-event is-done">
            <span class="dot-icon">{% icon "lucide:inbox" %}</span>
            <div class="info">
                <p><span class="bold">{{ languages['nl'][dossier.document_type] }}</span> (<a href="https://www.dekamer.be/FLWB/PDF/{{ dossier.session_id }}/{{ dossier.dossier_id | padLeft(4, '0') }}/{{ dossier.session_id }}K{{ dossier.dossier_id | padLeft(4, '0') }}001.pdf" target="_blank">{{ dossier.session_id }}K{{ dossier.dossier_id | padLeft(4, '0') }}001</a>)</p>
                <p style="font-size: small;">{{ dossier.submission_date | date }}</p>
                
                <!-- CHECK FOR VOTES ON INITIAL SUBMISSION (DOC 001) -->
                {% for subdoc in dossier.subdocuments %}
                {% if subdoc.id == 1 and subdoc.votes[0] %}
                <a class="flex space-between align-center" style="width: 100%;" href="/sessions/{{ subdoc.votes[0].session_id }}/meetings/plenary/{{ subdoc.votes[0].meeting_id }}/votes/{{subdoc.votes[0].vote_id}}/">
                <div class="vote-bar" style="width: 90%;">
                    <div class="bar-segment yes"
                         style="width: {{ (subdoc.votes[0].yes_count / ((subdoc.votes[0].yes_count | int) + (subdoc.votes[0].no_count | int) + (subdoc.votes[0].abstain_count | int)) * 100).toFixed(1) }}%">
                        {% if subdoc.votes[0].yes_count > 0 %}
                        <span class="bar-label">{{ (subdoc.votes[0].yes_count / ((subdoc.votes[0].yes_count | int) + (subdoc.votes[0].no_count | int) + (subdoc.votes[0].abstain_count | int)) * 100).toFixed(1) }}%</span>
                        {% endif %}
                    </div>
                    <div class="bar-segment no"
                         style="width: {{ (subdoc.votes[0].no_count / ((subdoc.votes[0].yes_count | int) + (subdoc.votes[0].no_count | int) + (subdoc.votes[0].abstain_count | int)) * 100).toFixed(1) }}%">
                        {% if subdoc.votes[0].no_count > 0 %}
                        <span class="bar-label">{{ (subdoc.votes[0].no_count / ((subdoc.votes[0].yes_count | int) + (subdoc.votes[0].no_count | int) + (subdoc.votes[0].abstain_count | int)) * 100).toFixed(1) }}%</span>
                        {% endif %}
                    </div>
                    <div class="bar-segment abstain"
                         style="width: {{ (subdoc.votes[0].abstain_count / ((subdoc.votes[0].yes_count | int) + (subdoc.votes[0].no_count | int) + (subdoc.votes[0].abstain_count | int)) * 100).toFixed(1) }}%">
                        {% if subdoc.votes[0].abstain_count > 0 %}
                        <span class="bar-label">{{ (subdoc.votes[0].abstain_count / ((subdoc.votes[0].yes_count | int) + (subdoc.votes[0].no_count | int) + (subdoc.votes[0].abstain_count | int)) * 100).toFixed(1) }}%</span>
                        {% endif %}
                    </div>
                </div>
                {% icon "lucide:chevron-right" %}
                </a>

                <p class="vote-numbers">
                    <span class="vote-dot yes"></span><span>{{ languages['nl'].yes }} ({{ subdoc.votes[0].yes_count }})</span>
                    <span class="vote-dot no"></span><span>{{ languages['nl'].no }} ({{ subdoc.votes[0].no_count }})</span>
                    <span class="vote-dot abstain"></span><span>{{ languages['nl'].abstain }} ({{ subdoc.votes[0].abstain_count }})</span>
                </p>
                {% endif %}
                {% endfor %}

                <ul style="display: flex; flex-direction: column; gap: 0.2rem;" class="links">
                    {% for author in dossier.authors %}


                    {% if author.name == "Gouvernement/Regering (AUTEUR)" %}
                    <span>Regering</span><br>
                    {% elseif author.name == "Commission/Commissie (AUTEUR)" %}
                    <span>Commissie</span><br>
                    {% elseif author.name == "Sénat/Senaat (AUTEUR)" %}
                    <span>Senaat</span><br>
                    {% else %}
                    {% set party = author.party | lower %}
                    {% set primaryColor = partyColors[party].primary or '#95a5a6' %}
                    {% set secondaryColor = partyColors[party].secondary or '#95a5a6' %}
                    <li class="gap" style="display: flex; margin-left: 0; width: 100%;"><a href="/parties/{{ author.party | slugify }}/" class="badge-link"><span class="party small" style="color: {{ primaryColor }}; background-color: {{ secondaryColor }};">{{ author.party }}</span></a><a href="/members/{{ author.name | slugify }}/">{{ author.name }}</a></li>
                    {% endif %}


                    {% endfor %}
                </ul>
            </div>
        </li>
    </ul>
</div>
{% else %}
<p>Er werden geen subdocumenten gevonden voor dit dossier.</p>
{% endif %}

{% if dossier.summary and dossier.summary.political_analysis.has_debate %}
<div class="ai-show-when-summary" style="margin-top: 3rem;">
    <h2>Politiek Debat</h2>
    <div class="summary-debate-grid">
        {% if dossier.summary.political_analysis.summary_debate %}
        <div class="summary-card summary-debate">
            <span class="summary-ai-badge">AI</span>
            <h3>Debat Samenvatting</h3>
            <div class="summary-content">{{ dossier.summary.political_analysis.summary_debate | markdown | safe }}</div>
        </div>
        {% endif %}

        {% if dossier.summary.political_analysis.arguments_for and dossier.summary.political_analysis.arguments_for.length > 0 %}
        {% for arg in dossier.summary.political_analysis.arguments_for %}
        <div class="summary-argument-card summary-argument-for">
            <span class="summary-ai-badge">AI</span>
            <div class="summary-argument-header summary-arguments-for">Voor</div>
            <div class="summary-argument-party">{{ arg.party }}</div>
            <div class="summary-argument-content">{{ arg.argument | markdown | safe }}</div>
        </div>
        {% endfor %}
        {% endif %}

        {% if dossier.summary.political_analysis.arguments_against and dossier.summary.political_analysis.arguments_against.length > 0 %}
        {% for arg in dossier.summary.political_analysis.arguments_against %}
        <div class="summary-argument-card summary-argument-against">
            <span class="summary-ai-badge">AI</span>
            <div class="summary-argument-header summary-arguments-against">Tegen</div>
            <div class="summary-argument-party">{{ arg.party }}</div>
            <div class="summary-argument-content">{{ arg.argument | markdown | safe }}</div>
        </div>
        {% endfor %}
        {% endif %}

        {% if dossier.summary.political_analysis.arguments and dossier.summary.political_analysis.arguments.length > 0 %}
        {% for arg in dossier.summary.political_analysis.arguments %}
        <div class="summary-argument-card">
            <span class="summary-ai-badge">AI</span>
            <div class="summary-argument-party">{{ arg.party }}</div>
            <div class="summary-argument-content">{{ arg.arguments | markdown | safe }}</div>
        </div>
        {% endfor %}
        {% endif %}
    </div>

    <div class="summary-meta">
        <p><strong>AI-gegenereerde samenvatting</strong> (Model: {{ dossier.summary.model }})</p>
        <p>Tokens: {{ dossier.summary.cost_info.tokens_input }} in, {{ dossier.summary.cost_info.tokens_output }} uit. Geschatte kost: ${{ dossier.summary.cost_info.cost_usd }}</p>
    </div>
</div>
{% endif %}
